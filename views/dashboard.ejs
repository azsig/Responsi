<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <h1>SMART MASJID</h1>
    <h1>Monitor</h1>
    <div class="date-time">
      <div id="date">Jun 10, 2024</div>
      <div id="time">9:41 AM</div>
    </div>
  </header>

  <section class="content">
    <div class="box" id="temperature">
      <div class="gauge-container">
        <div class="gauge-title">Temperature </div>
        <div class="gauge">
            <div class="gauge-marker"></div>
        </div>
        <div class="gauge-labels">
            <span>0 °C</span>
            <span>25 °C</span>
            <span>50 °C</span>
            <span>75 °C</span>
            <span>100 °C</span>
        </div>
        <div class="gauge-value"><%= data.temperature %> <span class="gauge-unit">°C</span></div>
      </div>
    </div>
    <div class="box" id="humidity">
      <div class="gauge-container">
        <div class="gauge-title">Humidity </div>
        <div class="gauge">
            <div class="gauge-marker"></div>
        </div>
        <div class="gauge-labels">
            <span>0 %</span>
            <span>25 %</span>
            <span>50 %</span>
            <span>75 %</span>
            <span>100 %</span>
        </div>
        <div class="gauge-value"><%= data.humidity %> <span class="gauge-unit">%</span></div>
      </div>
    </div>
 
    <div class="box" id="co2">
      <div class="gauge-container">
        <div class="gauge-title">Kadar CO₂ </div>
        <div class="gauge">
            <div class="gauge-marker"></div>
        </div>
        <div class="gauge-labels">
            <span>0 ppm</span>
            <span>250 ppm</span>
            <span>500 ppm</span>
            <span>750 ppm</span>
            <span>1000 ppm</span>
        </div>
        <div class="gauge-value"><%= data.co2 %> <span class="gauge-unit">ppm</span></div>
      </div>
    </div>
    <div class="box" id="lpg">
      <div class="gauge-container">
        <div class="gauge-title">Kadar Gas LPG </div>
        <div class="gauge">
            <div class="gauge-marker"></div>
        </div>
        <div class="gauge-labels">
            <span>0 ppm</span>
            <span>250 ppm</span>
            <span>500 ppm</span>
            <span>750 ppm</span>
            <span>1000 ppm</span>
        </div>
        <div class="gauge-value"><%= data.lpg %> <span class="gauge-unit">ppm</span></div>
      </div>
    </div>
    <div class="box" id="noise">
      <div class="gauge-container">
        <div class="gauge-title">Kebisingan </div>
        <div class="gauge">
            <div class="gauge-marker"></div>
        </div>
        <div class="gauge-labels">
            <span>0 dB</span>
            <span>30 dB</span>
            <span>60 dB</span>
            <span>90 dB</span>
            <span>120 dB</span>
        </div>
        <div class="gauge-value"><%= data.noise %> <span class="gauge-unit">dB</span></div>
      </div>
    </div>
    <div class="box" id="light">
      <div class="gauge-container">
        <div class="gauge-title">Pencahayaan </div>
        <div class="gauge">
            <div class="gauge-marker"></div>
        </div>
        <div class="gauge-labels">
            <span>0 dB</span>
            <span>250 lux</span>
            <span>500 lux</span>
            <span>750 lux</span>
            <span>1000 lux</span>
        </div>
        <div class="gauge-value"><%= data.light %> <span class="gauge-unit">lux</span></div>
      </div>
    </div>
    <div class="box Daya" id="power">
      <div class="gauge-container">
        <div class="gauge-title power">Daya </div>
        <div class="gauge-value"><%= data.power %> <span class="gauge-unit">W</span></div>
      </div>
      <div class="gauge-container current">
        <div class="gauge-title">Arus </div>
        <div class="gauge-value"><%= data.current %> <span class="gauge-unit">A</span></div>
      </div>
      <div class="gauge-container voltage">
        <div class="gauge-title">Tegangan </div>
        <div class="gauge-value"><%= data.voltage %> <span class="gauge-unit">V</span></div>
      </div>
    </div>
        <div class="box" id="people">
      <div class="gauge-container">
        <div class="gauge-title">Jumlah Orang </div>
        <div class="gauge-value"><%= data.people %> <span class="gauge-unit">orang</span></div>
      </div>
    </div>
    </div>
  </section>
  <div class="link">
    <a class="linkBox" href="/">HomePage</a>
  </div>
  
  
  

  
  <!-- Mercury Thermometer -->
  

  <script>
    const userData = <%- JSON.stringify(data) %>;
    console.log(userData) // Convert data to JSON
    const endpoint = '/dashboard/data/0';
  </script>
  <script src="/script.js"></script>
</body>
</html>